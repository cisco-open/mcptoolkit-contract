<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Example Catalog MCP Server v1.2.0</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      color: #111827;
      background: #f9fafb;
      padding: 2rem 1rem;
    }
    .container { max-width: 960px; margin: 0 auto; }
    a { color: #2563eb; text-decoration: none; }
    a:hover { text-decoration: underline; }
    code {
      font-family: 'SF Mono', 'Cascadia Code', 'Fira Code', Consolas, monospace;
      font-size: 0.875em;
      background: #f3f4f6;
      padding: 0.125em 0.375em;
      border-radius: 0.25rem;
    }
    pre {
      background: #1f2937;
      color: #e5e7eb;
      padding: 1rem;
      border-radius: 0.5rem;
      overflow-x: auto;
      font-size: 0.8125rem;
      line-height: 1.5;
    }
    pre code { background: none; padding: 0; color: inherit; }

    /* Cards */
    .card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      padding: 1.5rem;
      margin-bottom: 1rem;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04);
    }

    /* Info card */
    .info-card .title-row {
      display: flex;
      align-items: baseline;
      gap: 0.75rem;
      flex-wrap: wrap;
    }
    .info-card h1 {
      font-size: 1.5rem;
      font-weight: 700;
      color: #111827;
    }
    .info-card .description { margin-top: 0.75rem; color: #374151; }
    .info-card .meta { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.875rem; color: #6b7280; }
    .info-card .meta-item { display: flex; align-items: center; gap: 0.25rem; }

    /* Badges */
    .badge {
      display: inline-block;
      font-size: 0.6875rem;
      font-weight: 600;
      padding: 0.125rem 0.5rem;
      border-radius: 9999px;
      text-transform: uppercase;
      letter-spacing: 0.025em;
      vertical-align: middle;
    }
    .badge.version { background: #dbeafe; color: #1e40af; }
    .badge.protocol { background: #e0e7ff; color: #3730a3; }
    .badge.transport { background: #fef3c7; color: #92400e; }
    .badge.tool { background: #d1fae5; color: #065f46; }
    .badge.prompt { background: #ede9fe; color: #5b21b6; }
    .badge.resource { background: #fce7f3; color: #9d174d; }
    .badge.template { background: #ffedd5; color: #9a3412; }
    .badge.deprecated { background: #fef2f2; color: #991b1b; font-style: italic; }
    .badge.required { background: #fee2e2; color: #991b1b; font-size: 0.625rem; }
    .badge.tag { background: #f3f4f6; color: #374151; font-size: 0.625rem; font-weight: 500; text-transform: none; }
    .badge.cors-ready { background: #d1fae5; color: #065f46; }
    .badge.cors-fail { background: #fef2f2; color: #991b1b; }
    .badge.security { background: #fef9c3; color: #854d0e; }
    .badge.hint { background: #f3f4f6; color: #6b7280; font-weight: 500; text-transform: none; }

    /* Section headers */
    h2 {
      font-size: 1.125rem;
      font-weight: 600;
      color: #111827;
      display: inline;
    }
    .section-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem; }
    .count { font-size: 0.8125rem; color: #9ca3af; font-weight: 400; }
    .section-icon { font-size: 1.125rem; }

    /* Details / collapsible */
    details { border: none; }
    details > summary {
      cursor: pointer;
      user-select: none;
      list-style: none;
      padding: 0;
      display: flex;
      align-items: center;
    }
    details > summary::-webkit-details-marker { display: none; }
    details > summary::before {
      content: '▶';
      display: inline-block;
      font-size: 0.625rem;
      margin-right: 0.5rem;
      flex-shrink: 0;
      transition: transform 0.15s ease;
      color: #9ca3af;
    }
    details[open] > summary::before { transform: rotate(90deg); }

    /* Item cards (tools, prompts, etc.) */
    .item-detail {
      border: 1px solid #f3f4f6;
      border-radius: 0.5rem;
      margin-bottom: 0.5rem;
      overflow: hidden;
    }
    .item-detail > summary {
      padding: 0.625rem 0.75rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-wrap: wrap;
      background: #fafafa;
    }
    .item-detail > summary:hover { background: #f3f4f6; }
    .item-detail > summary .name { font-weight: 600; font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace; font-size: 0.875rem; }
    .item-detail > summary .title-text { color: #6b7280; font-size: 0.875rem; }
    .item-body { padding: 0.75rem 1rem 1rem; border-top: 1px solid #f3f4f6; }
    .item-body .description { color: #374151; font-size: 0.875rem; margin-bottom: 0.75rem; }

    /* Annotations / hints row */
    .hints { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.75rem; }

    /* Tags row */
    .tags { display: flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.5rem; }

    /* Schema tables */
    .schema-section { margin-top: 0.5rem; }
    .schema-toggle {
      font-size: 0.8125rem;
      font-weight: 600;
      color: #6b7280;
      padding: 0.25rem 0;
    }
    .schema-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
      margin-top: 0.375rem;
    }
    .schema-table th {
      text-align: left;
      color: #9ca3af;
      font-weight: 500;
      padding: 0.375rem 0.5rem;
      border-bottom: 1px solid #e5e7eb;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .schema-table td {
      padding: 0.375rem 0.5rem;
      border-bottom: 1px solid #f3f4f6;
      vertical-align: top;
    }
    .schema-table td:first-child { font-weight: 500; }
    .type-pill {
      display: inline-block;
      font-size: 0.6875rem;
      padding: 0.0625rem 0.375rem;
      border-radius: 0.25rem;
      background: #eff6ff;
      color: #1d4ed8;
      font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace;
    }
    .schema-json { margin-top: 0.5rem; }

    /* Transport items */
    .transport-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 0;
      border-bottom: 1px solid #f9fafb;
      font-size: 0.875rem;
    }
    .transport-item:last-child { border-bottom: none; }
    .transport-url { color: #6b7280; word-break: break-all; }

    /* URI display */
    .uri { color: #6b7280; font-size: 0.8125rem; word-break: break-all; font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace; }

    /* Resource / prompt argument list */
    .arg-list { margin: 0; padding: 0; list-style: none; }
    .arg-list li {
      padding: 0.25rem 0;
      font-size: 0.8125rem;
      border-bottom: 1px solid #f9fafb;
    }
    .arg-list li:last-child { border-bottom: none; }
    .arg-name { font-weight: 600; font-family: 'SF Mono', 'Cascadia Code', Consolas, monospace; }

    /* Footer */
    .footer {
      text-align: center;
      color: #9ca3af;
      font-size: 0.75rem;
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid #e5e7eb;
    }

    /* Responsive */
    @media (max-width: 640px) {
      body { padding: 1rem 0.5rem; }
      .card { padding: 1rem; }
      .info-card h1 { font-size: 1.25rem; }
    }
  </style>
</head>
<body>
  <div class="container">

    <!-- Info Card -->
    <div class="card info-card">
      <div class="title-row">
        <h1>Example Catalog MCP Server</h1>
        <span class="badge version">v1.2.0</span>
        <span class="badge protocol">MCP 2025-06-18</span>
      </div>
      <div class="description"><p>Sample MCP server exposing a generic catalog of items with search, detail
retrieval, and subscription prompts. Used to demonstrate mcpcontract
documentation generation (card-view template).</p>
</div>
      <div class="meta">
        <span class="meta-item"><strong>Name:</strong>&nbsp;com.example/catalog-server</span>




      </div>
    </div>

    <!-- Transports -->
    <div class="card">
      <div class="section-header">
        <span class="section-icon">🔌</span>
        <h2>Transports</h2>
        <span class="count">(1)</span>
      </div>
      <div class="transport-item">
        <span class="badge transport">streamable-http</span>
        <span class="transport-url">https://catalog.example.com/mcp</span>

      </div>
    </div>

    <!-- Security -->

    <!-- Tools -->
    <div class="card">
      <details open>
        <summary>
          <div class="section-header">
            <span class="section-icon">🔧</span>
            <h2>Tools</h2>
            <span class="count">(4)</span>
          </div>
        </summary>
        <details class="item-detail" open>
          <summary>
            <span class="badge tool">tool</span>
            <span class="name">search</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Search the catalog by name, category, or tag.</p>
<p>Common patterns:</p>
<ol>
<li>Find by name: <code>{&quot;name&quot;: &quot;widget&quot;, &quot;partial&quot;: true}</code></li>
<li>Filter by category: <code>{&quot;category&quot;: &quot;hardware&quot;}</code></li>
<li>Paginate: <code>{&quot;pageSize&quot;: 20, &quot;cursor&quot;: &quot;prev_cursor&quot;}</code></li>
</ol>
<p>Error codes:</p>
<ul>
<li><code>-32602</code> InvalidParams — missing or invalid parameter</li>
<li><code>-32603</code> InternalError — server-side failure</li>
</ul>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Input Schema</summary>
                <table class="schema-table">
                  <thead><tr><th>Property</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><code>name</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td></td>
                      <td>
                        Filter by item name (case-insensitive, partial match by default)





                      </td>
                    </tr>
                    <tr>
                      <td><code>category</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td></td>
                      <td>
                        Filter by category slug (e.g. &#x60;hardware&#x60;, &#x60;software&#x60;, &#x60;service&#x60;)





                      </td>
                    </tr>
                    <tr>
                      <td><code>tag</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td></td>
                      <td>
                        Filter by tag (exact match)





                      </td>
                    </tr>
                    <tr>
                      <td><code>partial</code></td>
                      <td>
                        <span class="type-pill">boolean</span>

                      </td>
                      <td></td>
                      <td>
                        When true, &#x60;name&#x60; and &#x60;category&#x60; use substring matching
                         <em>Default: true</em>




                      </td>
                    </tr>
                    <tr>
                      <td><code>pageSize</code></td>
                      <td>
                        <span class="type-pill">integer</span>

                      </td>
                      <td></td>
                      <td>
                        Results per page (1–100, default 10)
                         <em>Default: 10</em>

                         <em>Range: 1-100</em>


                      </td>
                    </tr>
                    <tr>
                      <td><code>cursor</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td></td>
                      <td>
                        Pagination cursor from a previous response





                      </td>
                    </tr>
                  </tbody>
                </table>
              </details>
            </div>
          </div>
        </details>
        <details class="item-detail">
          <summary>
            <span class="badge tool">tool</span>
            <span class="name">get-item</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Retrieve full details for a single catalog item by its ID.</p>
<p>Returns all fields including description, tags, category, contacts,
and release history.</p>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Input Schema</summary>
                <table class="schema-table">
                  <thead><tr><th>Property</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><code>id</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td><span class="badge required">required</span></td>
                      <td>
                        Unique item identifier





                      </td>
                    </tr>
                    <tr>
                      <td><code>fields</code></td>
                      <td>
                        <span class="type-pill">array</span>

                      </td>
                      <td></td>
                      <td>
                        Optional subset of fields to return (all returned by default)





                      </td>
                    </tr>
                  </tbody>
                </table>
              </details>
            </div>
          </div>
        </details>
        <details class="item-detail">
          <summary>
            <span class="badge tool">tool</span>
            <span class="name">list-categories</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>List all available categories with item counts.</p>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Input Schema</summary>
                <table class="schema-table">
                  <thead><tr><th>Property</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><code>includeEmpty</code></td>
                      <td>
                        <span class="type-pill">boolean</span>

                      </td>
                      <td></td>
                      <td>
                        Include categories that contain no items





                      </td>
                    </tr>
                  </tbody>
                </table>
              </details>
            </div>
          </div>
        </details>
        <details class="item-detail">
          <summary>
            <span class="badge tool">tool</span>
            <span class="name">subscribe-updates</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Register a webhook to receive change notifications for matching items.</p>
<p>The server POSTs a JSON payload to <code>callbackUrl</code> whenever a matching
item is created, updated, or deleted.</p>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Input Schema</summary>
                <table class="schema-table">
                  <thead><tr><th>Property</th><th>Type</th><th>Required</th><th>Description</th></tr></thead>
                  <tbody>
                    <tr>
                      <td><code>callbackUrl</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td><span class="badge required">required</span></td>
                      <td>
                        HTTPS endpoint to receive change notifications



                         <em>Format: uri</em>

                      </td>
                    </tr>
                    <tr>
                      <td><code>filter</code></td>
                      <td>
                        <span class="type-pill">object</span>

                      </td>
                      <td></td>
                      <td>
                        Same filter fields as &#x60;search&#x60; — only matching changes trigger callbacks





                      </td>
                    </tr>
                    <tr>
                      <td><code>secret</code></td>
                      <td>
                        <span class="type-pill">string</span>

                      </td>
                      <td></td>
                      <td>
                        HMAC-SHA256 signing secret; if provided, notifications include an &#x60;X-Signature&#x60; header





                      </td>
                    </tr>
                  </tbody>
                </table>
              </details>
            </div>
          </div>
        </details>
      </details>
    </div>

    <!-- Prompts -->
    <div class="card">
      <details open>
        <summary>
          <div class="section-header">
            <span class="section-icon">💬</span>
            <h2>Prompts</h2>
            <span class="count">(2)</span>
          </div>
        </summary>
        <details class="item-detail" open>
          <summary>
            <span class="badge prompt">prompt</span>
            <span class="name">guided-search</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Interactive prompt that helps users compose an effective search query.
Asks clarifying questions and returns a ready-to-use <code>search</code> tool call.</p>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Arguments</summary>
                <ul class="arg-list">
                  <li>
                    <span class="arg-name">intent</span>
                    <span class="badge required">required</span>
                     — What the user is looking for in natural language
                  </li>
                </ul>
              </details>
            </div>
          </div>
        </details>
        <details class="item-detail">
          <summary>
            <span class="badge prompt">prompt</span>
            <span class="name">summarize-item</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Summarize a catalog item in one paragraph for non-technical audiences.</p>
</div>
            <div class="schema-section">
              <details open>
                <summary class="schema-toggle">Arguments</summary>
                <ul class="arg-list">
                  <li>
                    <span class="arg-name">item_id</span>
                    <span class="badge required">required</span>
                     — ID of the item to summarize
                  </li>
                  <li>
                    <span class="arg-name">audience</span>

                     — Target audience: &#x60;technical&#x60; or &#x60;executive&#x60; (default: &#x60;technical&#x60;)
                  </li>
                </ul>
              </details>
            </div>
          </div>
        </details>
      </details>
    </div>

    <!-- Resources -->
    <div class="card">
      <details open>
        <summary>
          <div class="section-header">
            <span class="section-icon">📦</span>
            <h2>Resources</h2>
            <span class="count">(2)</span>
          </div>
        </summary>
        <details class="item-detail" open>
          <summary>
            <span class="badge resource">resource</span>
            <span class="name">catalog-stats</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Aggregate statistics — total item count, category breakdown, last-updated timestamp.</p>
</div>
            <div style="margin-bottom:0.5rem;"><strong>URI:</strong> <span class="uri">catalog://stats</span></div>
            <div style="margin-bottom:0.5rem; font-size:0.8125rem; color:#6b7280;">MIME: <code>application/json</code></div>
          </div>
        </details>
        <details class="item-detail">
          <summary>
            <span class="badge resource">resource</span>
            <span class="name">categories</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Complete list of categories with slugs, display names, and item counts.</p>
</div>
            <div style="margin-bottom:0.5rem;"><strong>URI:</strong> <span class="uri">catalog://categories</span></div>
            <div style="margin-bottom:0.5rem; font-size:0.8125rem; color:#6b7280;">MIME: <code>application/json</code></div>
          </div>
        </details>
      </details>
    </div>

    <!-- Resource Templates -->
    <div class="card">
      <details open>
        <summary>
          <div class="section-header">
            <span class="section-icon">📋</span>
            <h2>Resource Templates</h2>
            <span class="count">(1)</span>
          </div>
        </summary>
        <details class="item-detail" open>
          <summary>
            <span class="badge template">template</span>
            <span class="name">item-detail</span>


          </summary>
          <div class="item-body">
            <div class="description"><p>Full detail record for the item with the given <code>id</code>.</p>
</div>
            <div style="margin-bottom:0.5rem;"><strong>URI Template:</strong> <span class="uri">catalog://items/{id}</span></div>
            <div style="margin-bottom:0.5rem; font-size:0.8125rem; color:#6b7280;">MIME: <code>application/json</code></div>
          </div>
        </details>
      </details>
    </div>

    <!-- Tags -->

    <!-- Extraction Details (CORS, Session, etc.) -->

    <!-- Footer -->
    <div class="footer">
      Generated by <a href="https://github.com/cisco-open/mcptoolkit-contract">mcpcontract</a>
    </div>

  </div>

</body>
</html>
